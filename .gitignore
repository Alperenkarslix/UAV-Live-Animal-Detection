# OS
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.pytest_cache/

# Virtual envs
.venv/
env/
venv/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Jupyter
.ipynb_checkpoints/

# App runtime
*.log
.output_*.json

# Training data & results (large, not for git)
datasets/
runs/

# Model weights (binary, large — distribute via Releases / S3 / Git LFS)
*.pt
*.onnx
*.mlpackage
*.mlmodel
*.zip

# Large downloaded videos (keep only small test clips in videos/)
videos/safari*
videos/*.f[0-9]*.mp4

# Training artifacts inside yolomodel/ (plots, batch previews, csv logs)
# Weights themselves are distributed separately — see README.
yolomodel/**/*.png
yolomodel/**/*.jpg
yolomodel/**/*.jpeg
yolomodel/**/*.csv
yolomodel/**/args.yaml
